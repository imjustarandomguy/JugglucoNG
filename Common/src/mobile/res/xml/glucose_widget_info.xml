<?xml version="1.0" encoding="utf-8"?>
<!-- "Glucose": fits one row; tall sizes just centre a bigger value. Readings drive
     the updates, so no periodic update (updatePeriodMillis="0"). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_value_description"
    android:initialKeyguardLayout="@layout/widget_glucose_loading"
    android:initialLayout="@layout/widget_glucose_loading"
    android:maxResizeHeight="400dp"
    android:maxResizeWidth="600dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget"
    android:previewLayout="@layout/widget_glucose_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
